# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Site URL (requerido para OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth: se configura en Supabase Dashboard, NO aqui
# Ver: Supabase Dashboard > Authentication > Providers > Google

# PWA Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:marcoapereirav@gmail.com

# Fathom (Team plan: API + webhooks)
FATHOM_API_KEY=
FATHOM_WEBHOOK_SECRET=

# OpenRouter (LLM classifier)
OPENROUTER_API_KEY=

# Content Intel (análisis IG + generación de guiones)
APIFY_TOKEN=
GEMINI_API_KEY=

# Video Edit (transcripción Whisper para edición automática)
# Crear token en https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Google Calendar OAuth (panel admin → conectar cuenta de Adrián para crear eventos+Meet)
# 1. Google Cloud Console → APIs & Services → OAuth consent screen → External
# 2. Credentials → Create OAuth client ID → Web application
# 3. Authorized redirect URIs: https://os.capitalhubapp.com/api/admin/google-calendar/callback
# 4. Habilitar Calendar API en el proyecto
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://os.capitalhubapp.com/api/admin/google-calendar/callback

# Whop embedded checkout (cliente lee el plan_id MES en browser para montar el embed)
NEXT_PUBLIC_WHOP_PLAN_ID_MES=plan_xxx
